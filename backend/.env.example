# Environment: development, test, or production
NODE_ENV=development

# Server port (default 5000)
PORT=5000

# MongoDB connection URI
# Example: mongodb://localhost:27017/skinscan
MONGO_URI=mongodb://localhost:27017/skinscan

# JWT Secret for signing authentication tokens
# MUST be set in production - use a strong, random string
# Example: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# (Optional) HTTPS enforcement in production
# Set to 'true' to enforce HTTPS redirects
ENFORCE_HTTPS=false
